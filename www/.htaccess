# ============================================================
# Sari Endocrinology & Diabetes Center - .htaccess
# ============================================================

# Enable Rewrite Engine
RewriteEngine On

# ============================================================
# Security Headers
# ============================================================
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Clickjacking Protection
    Header always set X-Frame-Options "DENY"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # HSTS (uncomment for production with HTTPS)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    
    # Content Security Policy (customize as needed)
    # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:;"
</IfModule>

# ============================================================
# Protect Sensitive Files
# ============================================================

# Protect sensitive directories using RewriteRule
RewriteRule ^config/ - [F,L]
RewriteRule ^includes/ - [F,L]

# Protect SQL, MD, LOG, ENV files
RewriteRule \.(sql|md|log|env)$ - [F,L]

# Protect SQL files
<FilesMatch "\.(sql|md|log|env)$">
    Order deny,allow
    Deny from all
</FilesMatch>

# Protect install.php after installation
# Uncomment after installation:
# <Files "install.php">
#     Order deny,allow
#     Deny from all
# </Files>

# Protect .htaccess itself
<Files ".htaccess">
    Order deny,allow
    Deny from all
</Files>

# ============================================================
# Directory Protection
# ============================================================

# Disable directory listing
Options -Indexes

# Protect uploads directory from PHP execution
<Directory "uploads/">
    php_flag engine off
</Directory>

# ============================================================
# Error Pages
# ============================================================
ErrorDocument 403 /error-404.php
ErrorDocument 404 /error-404.php
ErrorDocument 500 /error-404.php

# ============================================================
# URL Rewriting (optional - for clean URLs)
# ============================================================

# Rewrite module paths
# Example: /patients/123 -> /modules/patients/view.php?id=123
# RewriteRule ^patients/(\d+)$ modules/patients/view.php?id=$1 [L,QSA]
# RewriteRule ^patients/(\d+)/edit$ modules/patients/edit.php?id=$1 [L,QSA]
# RewriteRule ^visits/(\d+)$ modules/visits/view.php?id=$1 [L,QSA]

# ============================================================
# Character Set
# ============================================================
AddDefaultCharset UTF-8

# ============================================================
# Cache Control
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ============================================================
# PHP Settings
# ============================================================
<IfModule mod_php7.c>
    # Max upload size 10MB
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 120
    php_value max_input_time 120
    
    # Session settings
    php_value session.use_strict_mode 1
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite "Lax"
</IfModule>
